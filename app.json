{
  "expo": {
    "name": "محاميك",
    "slug": "mohamik",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mohamik",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "sa.alraed.mohamik",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "ExpoLocalization_forcesRTL": true
      }
    },
    "android": {
      "package": "sa.alraed.mohamik",
      "adaptiveIcon": {
        "backgroundColor": "#0F2A3D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F2A3D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم محاميك بصمة الوجه لقفل التطبيق وحماية قضاياك."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E2433",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج محاميك إلى صورك لرفع المحاضر والأحكام والمستندات.",
          "cameraPermission": "يحتاج محاميك إلى الكاميرا لتصوير المحاضر والأحكام والمستندات.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": true,
      "forcesRTL": true,
      "eas": {
        "projectId": "5652c650-bdf8-427c-aa07-b18f529fe0fc"
      }
    },
    "owner": "admin325"
  }
}
